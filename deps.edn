;; kotoba-lang/gpu — kami.gpu SSoT (capability-gated GPU pipeline IR).
;; Extracted from webgpu (ADR-2607102200 addendum 6). Pure .cljc; no GPU executor.
{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.11.1"}
        org.clojure/clojurescript {:mvn/version "1.11.132"}
        ;; kami.gpu.launch: launch geometry derived from the hardware
        ;; descriptor, and tile ordering shared with the CPU-cache work rather
        ;; than reimplemented here.
        io.github.kotoba-lang/machine
        {:git/url "https://github.com/kotoba-lang/machine.git"
         :git/sha "5e99d3ecde7489ae64755d3a4abb193f4a3cb2f6"}
        io.github.kotoba-lang/traversal
        {:git/url "https://github.com/kotoba-lang/traversal.git"
         :git/sha "a04f066ec675728813017cf7ba20c4a089448b59"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test" "--fail-level" "error"]}}}
